# ============================================
# Platform Foundation — Environment Variables
# ============================================
# NOTE: This file documents ALL environment variables used by the
# platform and shared features. Do not commit this file with real values.
# Copy to .env.local for local development, .env.staging and .env.production
# for each environment, or use Railway's environment UI to set values.
#
# All environment-specific secrets (database connection string, authentication
# secrets, etc.) MUST be provided through Railway environment variables or
# .env.* files — never hard-code them in code or appsettings.json.
#
# When deploying to Railway, create an Environment Variable for each key below,
# then add it to the Railway environment (Settings → Environment variables).
#
# -- Required by this platform feature (Chunk 1) --

ASPNETCORE_URLS=http://0.0.0.0:5000

# Railway-managed PostgreSQL connection string
# Railway injects this in 'libpq' URI form: postgresql://user:pass@host:port/db
# The application translates this to NpgsqlConnectionStringBuilder format
# at startup. If missing in Production, the application will fail fast
# on startup (no fallback to localhost in non-Development environments).
DATABASE_URL=postgresql://<railway_db_user>:<railway_db_password>@<railway_db_host>:5432/<railway_db_name>

# -- Provided by auth-foundation (soft dependency) --
# These are OUT OF SCOPE for this chunk but are required by the auth feature.
# When auth-foundation lands, add the following to .env.example and create
# corresponding Railway environment variables.

# Auth0 configuration (for login/logout via Auth0)
# Auth0__Domain=<your_auth0_domain>
# Auth0__Audience=<your_auth0_audience>

# Google OAuth configuration (for Google Sign-In via Google Identity Services)
# Google__ClientId=<your_google_client_id>
# Google__ClientSecret=<your_google_client_secret>

# -- Operational / shared configuration --
# These are platform/shared settings, not auth-specific.

# Sentry DSN for error tracking
# See: docs/specs/operations/environments.md
# Sentry_Dsn=https://<sentry_org_secret_key>@o<sentry_project_id>.ingest.sentry.io/<sentry_project_id>

# Serilog minimum log level for production deployments
# Lowering log level in Production exposes secrets and PII in logs
# Valid values: Critical, Error, Warning, Information, Debug, Trace
# See: docs/specs/operations/environments.md
Logging__MinimumLevel=Warning
Logging__AllowedProperties=Microsoft.AspNetCore,Microsoft.EntityFrameworkCore.Database.Command

# -- Migration bundle execution --
# These control which modules run migrations and in what order
# See: docs/specs/operations/deploy.yml (migration bundles are pre-executed in CI)

# Modules: BoardDbContext, TaskDbContext, UserDbContext, MembershipDbContext
# These must be maintained in sorted order to preserve foreign key relationships.
# When adding a new migration, prepend the new module name to the list.
MigrationModuleOrder=BoardDbContext,TaskDbContext,UserDbContext,MembershipDbContext
