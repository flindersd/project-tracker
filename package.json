{
  "name": "initiative-tracker",
  "private": true,
  "workspaces": [
    "src/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present && dotnet format --verify-no-changes --no-restore src/api/ProjectTracker.Api.sln",
    "test": "npm run test --workspaces --if-present && dotnet test src/api/ProjectTracker.Api.sln --no-restore",
    "build": "npm run build --workspaces --if-present && dotnet build src/api/ProjectTracker.Api.sln --no-restore",
    "dev:web": "npm run dev --workspace @initiative-tracker/web",
    "dev:api": "dotnet run --project src/api/ProjectTracker.Api.csproj",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
